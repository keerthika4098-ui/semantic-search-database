use retailDB

db.sales.insertMany([
  { product: "Laptop", category: "Electronics", quantity: 2, price: 50000 },
  { product: "Phone", category: "Electronics", quantity: 5, price: 20000 },
  { product: "Chair", category: "Furniture", quantity: 4, price: 3000 },
  { product: "Table", category: "Furniture", quantity: 2, price: 7000 },
  { product: "Headphones", category: "Electronics", quantity: 3, price: 2000 }
])

db.sales.aggregate([
  {
    $group: {
      _id: "$category",
      totalSales: {
        $sum: { $multiply: ["$quantity", "$price"] }
      },
      totalQuantity: { $sum: "$quantity" },
      numberOfProducts: { $sum: 1 }
    }
  },
  { $sort: { totalSales: -1 } }
])